APP_NAME=FUTNEXIS
APP_ENV=local
APP_KEY=
# Producción: APP_ENV=production y APP_DEBUG=false.
APP_DEBUG=true
# Base de los enlaces enviados por correo. Producción: la URL HTTPS definitiva.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Los registros diarios se conservan 14 días. Nunca usar MAIL_MAILER=log en producción:
# escribiría en el registro los enlaces de activación y de recuperación.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Producción: MariaDB 11.4.13. Las pruebas usan siempre futnexis_testing (ver phpunit.xml).
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=futnexis
DB_USERNAME=root
DB_PASSWORD=

# El cifrado y los 30 minutos de inactividad están fijados en config/session.php.
SESSION_DRIVER=database
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción la cookie es Secure por defecto; esta variable solo sirve para anularlo.
# SESSION_SECURE_COOKIE=true

# Proxies inversos delante de la aplicación (IP o CIDR, separados por comas).
# Déjalo vacío si no hay ninguno: las cabeceras reenviadas se ignoran. No se admite "*".
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Producción (la contraseña solo en el .env del servidor, nunca en el repositorio):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=mail.gltechsolutions.com
# MAIL_PORT=465
# MAIL_USERNAME=notificaciones@gltechsolutions.com
# MAIL_FROM_ADDRESS="notificaciones@gltechsolutions.com"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
